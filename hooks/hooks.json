{
  "description": "orbit 에이전트 정책 — ORBIT_AGENT_POLICY=on일 때만 위임 타입을 orbit 접근 모드로 유도한다(기본 꺼짐)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-policy.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

#!/usr/bin/env bash
# harness pre-commit 훅 — 일지만 바뀐 커밋을 막는다.
# worklog는 턴마다 바뀌어서, 그것만 따로 커밋하면 커밋 기록이 일지로 찬다.
# 일지는 커밋하지 않은 채로 두고 다음 작업 커밋에 함께 싣는다.
#
# 활성화(레포당 1회): git config core.hooksPath .githooks
# 사용자가 일지만이라도 커밋하라고 했을 때: ORBIT_ALLOW_WORKLOG_ONLY_COMMIT=1 git commit ...
#
# 프로젝트 검사(테스트 등)는 이 파일에 넣지 말고 .githooks/pre-commit.local(실행 권한)에 둔다.
# 그 검사는 허용 변수를 붙였거나 병합 중이어도 늘 먼저 돈다. 허용 변수는 아래 '일지만' 검사만 끈다.
# (예전에는 허용 변수가 훅 전체를 건너뛰어, 이 파일 뒤쪽에 넣은 npm test까지 빠졌다 — 장기기억 비교 시험 r1)

local_hook="$(git rev-parse --show-toplevel)/.githooks/pre-commit.local"
if [ -x "$local_hook" ]; then
  "$local_hook" "$@" || exit 1
fi

[ "${ORBIT_ALLOW_WORKLOG_ONLY_COMMIT:-}" = "1" ] && exit 0

# 병합·리베이스·체리픽 중에는 막지 않는다(이미 있는 커밋을 옮기는 일이다).
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  [ -e "$(git rev-parse --git-path "$marker")" ] && exit 0
done

staged="$(git -c core.quotePath=false diff --cached --name-only)"
[ -z "$staged" ] && exit 0

rest="$(printf '%s\n' "$staged" | grep -v -x -e '{{DOCS_DIR}}/worklog.md' -e '{{DOCS_DIR}}/worklog-state.json')"
[ -n "$rest" ] && exit 0

echo "" >&2
echo "⛔ harness: 일지(worklog)만 바뀐 커밋은 만들지 않습니다." >&2
echo "   → 일지는 커밋하지 않은 채로 두고, 다음 작업 커밋에 함께 싣습니다." >&2
echo "   (사용자가 일지만이라도 커밋하라고 말했다면: ORBIT_ALLOW_WORKLOG_ONLY_COMMIT=1 을 붙여 다시 실행)" >&2
echo "   그냥 \"커밋해\"라는 요청이었다면 커밋하지 말고, 바꾼 코드가 없어 커밋할 것이 없다고 답합니다." >&2
echo "" >&2
exit 1
